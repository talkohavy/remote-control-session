# Copy to .env and fill in. Everything here is optional: with no .env at all the app uses
# the public PeerJS broker and public STUN, which is enough on ordinary home networks.
#
# These are VITE_ variables, so they are read at BUILD time and inlined into the renderer
# bundle - not read from disk at runtime. Rebuild after changing them, and treat any value
# here as public in a distributed build, because it can be extracted from the bundle.

# --- TURN relay ---------------------------------------------------------------------------
# Needed when either peer is behind symmetric NAT - normal on corporate and mobile-carrier
# networks. STUN alone cannot traverse it and the connection simply fails with no useful
# error. Include the TCP/443 variant: on networks that block UDP it is the difference
# between connecting and not, because it looks like ordinary HTTPS.
#
# This app sends a static username/credential, so the provider must issue long-term
# credentials. Cloudflare's free tier will not work unmodified - it only issues credentials
# that expire within 48 hours, which needs code to refresh them.
VITE_PORT=8000
VITE_TURN_URLS=turn:relay.example.com:443?transport=tcp,turn:relay.example.com:3478
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --- Signaling ---------------------------------------------------------------------------
# Only needed to replace PeerJS's shared public broker, which is rate limited and offers no
# uptime guarantee. Self-host with `npx peerjs --port 9000`.
# VITE_PEER_HOST=signal.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
